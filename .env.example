DATABASE_URL="file:./dev.db"
PORT=3000
HOST="0.0.0.0"
OAUTH_JWT_SECRET="replace-with-a-random-secret-before-non-demo-use"
OAUTH_ISSUER="https://auth.platform.local"
OAUTH_AUDIENCE="https://api.platform.local"
FIXTURES_DIR=fixtures

# Optional upstream HTTP adapters. Omit to use local fixture adapters.
# CRM_BASE_URL=http://crm:8080
# ERP_BASE_URL=http://erp:8080
# USAGE_FEED_BASE_URL=http://usage:8080

# Optional assignment LLM demo settings. Set OPENAI_API_KEY in the shell; do not store it here.
# NEST_API_BASE_URL=http://localhost:3000
# NEST_API_TOKEN=<delegated read-only bearer token>
# MCP_DEMO_LLM_URL=https://api.openai.com/v1/chat/completions
# MCP_DEMO_LLM_MODEL=gpt-4o-mini
# MCP_DEMO_AS_OF=2026-11-25T00:00:00.000Z
